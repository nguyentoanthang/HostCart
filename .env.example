# ==============================================================================
# HostCart Multi-Media Rebuild - Environment Configuration Template
# Copy this file to '.env' and adjust values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# High-entropy secret key used to sign JWT authentication tokens.
# Generate a strong key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string

# Access token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
# Bind address and port for the FastAPI uvicorn server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ------------------------------------------------------------------------------
# Database Storage
# ------------------------------------------------------------------------------
# Path to the SQLite database file (persisted under ./data in Docker)
DATABASE_URL=data/hostcart.db

# ------------------------------------------------------------------------------
# External Metadata Providers (Optional)
# ------------------------------------------------------------------------------
# IGDB (Video Games): Requires a free Twitch Developer account
# Register an app at https://dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# The Movie Database - TMDB (Movies & TV Shows)
# Register a free account and generate an API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Google Books (Books fallback)
# OpenLibrary works out of the box with zero configuration.
# If desired, supply a Google Books API key from https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=
