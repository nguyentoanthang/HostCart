{
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "debug": false,
    "cors_origins": ["*"],
    "api_prefix": "/api/v1"
  },
  "database": {
    "db_file": "data/hostcart.db"
  },
  "security": {
    "secret_key": "insecure-change-in-production-secret-key-hostcart",
    "algorithm": "HS256",
    "access_token_expire_minutes": 1440,
    "bcrypt_rounds": 12
  },
  "providers": {
    "igdb": {
      "client_id": "",
      "client_secret": ""
    },
    "tmdb": {
      "api_key": ""
    },
    "books": {
      "google_books_api_key": "",
      "openlibrary_enabled": true
    }
  },
  "features": {
    "wishlist": {
      "enabled": true,
      "max_items": 1000
    },
    "playtime_tracking": {
      "enabled": true
    },
    "ratings": {
      "enabled": true,
      "scale": 10
    },
    "reviews": {
      "enabled": true,
      "max_length": 2000
    },
    "tags": {
      "enabled": true,
      "max_tags": 20
    }
  },
  "web_ui": {
    "title": "HostCart Multi-Media Collection",
    "theme": "arcadia"
  }
}
